{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "otdx-envelope.schema.json",
  "title": "OTDX batch envelope (draft 0.1)",
  "type": "object",
  "required": [
    "otdx", "batch_id", "provider", "profiles", "created_at",
    "event_count", "payload_encoding", "payload_sha256"
  ],
  "properties": {
    "otdx": {"const": "0.1"},
    "batch_id": {"$ref": "otdx-defs.schema.json#/$defs/uuid"},
    "provider": {"$ref": "otdx-defs.schema.json#/$defs/issuer"},
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "critical"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"},
          "critical": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "created_at": {"$ref": "otdx-defs.schema.json#/$defs/timestamp"},
    "event_count": {"type": "integer", "minimum": 0},
    "payload_encoding": {"enum": ["jsonl", "jsonl+zstd"]},
    "payload_sha256": {
      "$ref": "otdx-defs.schema.json#/$defs/sha256hex",
      "description": "SHA-256 of the payload bytes as transmitted (compressed form if compressed)"
    },
    "signature": {
      "type": "object",
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": {"const": "Ed25519"},
        "key_id": {"type": "string"},
        "sig": {"$ref": "otdx-defs.schema.json#/$defs/base64"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
